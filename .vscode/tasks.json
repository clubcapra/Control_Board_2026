{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PIO: Build flight",
      "type": "shell",
      "command": "${env:USERPROFILE}\\.platformio\\penv\\Scripts\\platformio.exe",
      "args": ["run", "-e", "bluepill_flight"],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": ["$platformio"]
    },
    {
      "label": "PIO: Upload flight",
      "type": "shell",
      "command": "${env:USERPROFILE}\\.platformio\\penv\\Scripts\\platformio.exe",
      "args": ["run", "-e", "bluepill_flight", "-t", "upload"],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": ["$platformio"]
    },
    {
      "label": "PIO: Upload + monitor flight",
      "type": "shell",
      "command": "${env:USERPROFILE}\\.platformio\\penv\\Scripts\\platformio.exe",
      "args": ["run", "-e", "bluepill_flight", "-t", "upload", "-t", "monitor"],
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    }
  ]
}
